{
  "name": "ARS-SKIPP: AI Captcha Image Solver",
  "version": "0.26.71",
  "homepage_url": "https://github.com/Arslan-TR/ars-cap-skipp",
  "description": "Solves image captcha challenges on your device with built-in neural networks. Free, no account or API key needed.",
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": [
        "models/type.onnx",
        "models/grid.onnx",
        "models/grid.meta.json",
        "models/motorcycles_b1.onnx",                          
        "models/motorcycles_b1.meta.json",  
        "lib/sql-wasm.wasm",
        "lib/sql-wasm.js",
        "lib/sql-wasm-wrapper.js",
        "lib/sql-wasm.mjs",
        "db/captcha.sqlite",
        "background_sqlite.js",
        "captcha/phash-browser.js",
        "libs/onnxruntime-web/**",
        "captcha/libs/onnxruntime-web/**",
        "captcha/recaptcha_ai.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/recaptcha/*"
      ],
      "js": ["eventhook/loader.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/recaptcha/*"
      ],
      "js": [
        "eventhook.js",
        "captcha/recaptcha.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "manifest_version": 3,
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "idle",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "ARS-SKIPP",
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "128": "icon/128.png"
    },
    "default_popup": "popup.html"
  },
"host_permissions": [
  "*://*.google.com/recaptcha/*"
],
  "minimum_chrome_version": "111",
  "version_name": "0.26.71"
}
